# 数据库类型：sqlite | mysql | sqlserver（运行 npm run db:generate / db:push 前会写入 prisma/schema.prisma）
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# —— SQL Server（可选，生产环境）——
# DATABASE_PROVIDER=sqlserver
# MSSQL_SERVER=YOUR_HOST\\INSTANCE_NAME
# MSSQL_USER=sa
# MSSQL_PASSWORD=YOUR_PASSWORD
# DATABASE_URL="sqlserver://;server=YOUR_HOST\\INSTANCE_NAME;database=gdzc;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"
# 首次建库：npm run db:create  再  npm run db:push && npm run db:seed

# JWT 密钥（生产环境务必修改）
JWT_SECRET="please-change-in-production"

# 服务器纳管凭据加密（可选）：64 位十六进制 = 32 字节 AES 密钥；未设置则密码仍以明文写入数据库（演示环境）
# SERVER_CREDENTIAL_KEY=

# ERP 出站 Webhook（可选）：配置后队列处理将 POST JSON；留空则直接标记 DONE（离线演示）
# ERP_WEBHOOK_URL="https://erp.example.com/api/gdzc/sync"
# ERP_WEBHOOK_SECRET="shared-secret-for-hmac-sha256-body"
# ERP_TIMEOUT_MS=15000

# 定时同步心跳（可选）：大于 0 时按分钟间隔写入 SyncJobState 与审计；0 或未设置则不启用
# SYNC_SCHEDULER_MINUTES=0

# 企业微信通讯录远程拉取（可选，需服务器能访问 qyapi.weixin.qq.com）
# 使用「通讯录同步」或具备通讯录只读权限的应用 Secret
# WEWORK_CORP_ID=wwxxxxxxxxxxxxxxxx
# WEWORK_CORP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# user/list 的根部门 id，默认 1（若企业根部门不是 1 请修改）
# WEWORK_ROOT_DEPT_ID=1
# 配置后可用：npm run test:wework（仅测 gettoken）或管理端「同步日志」→「从企微拉取通讯录」
